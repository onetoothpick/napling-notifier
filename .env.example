# Copy this file to .env and fill it in. Never commit your real .env.
# Leave a source's variables blank to disable that source.

# --- Required ---
DISCORD_WEBHOOK_URL=

# --- Bluesky ---
# Handle (without the @) or DID of the account to watch
BSKY_ACTOR=
# Role ID to ping for new posts (optional)
BSKY_ROLE_ID=
BSKY_POLL_SECONDS=60

# --- YouTube (needs both the API key and the channel ID) ---
YOUTUBE_API_KEY=
# Channel ID, starting with UC
YT_CHANNEL_ID=
# Role ID to ping for all YouTube notifications (optional)
YT_ROLE_ID=
YT_POLL_SECONDS=120
# Also announce scheduled streams, and handle reschedules and cancellations
YT_NOTIFY_SCHEDULED=false
# Reschedules smaller than this edit the original message quietly; larger ones
# also post a new pinging message. Only used if YT_NOTIFY_SCHEDULED=true
YT_RESCHEDULE_THRESHOLD_MINUTES=60

# --- Optional ---
LOG_LEVEL=INFO
# Where state is stored. The Docker image already sets this to /data/state.db
# DB_PATH=state.db
